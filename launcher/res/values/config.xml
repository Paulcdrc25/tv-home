<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh.
  Package names: tools/venv/bin/python -I tools/tv.py 'pm list packages'
-->
<resources>
    <!-- Dock apps, left to right. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>io.gh.reisxd.tizentube.cobalt</item>
        <item>com.stremio.one</item>
        <item>com.nst.iptvsmarterstvbox</item>
        <item>com.netflix.ninja</item>
        <item>tv.twitch.android.app</item>
        <item>com.spotify.tv.android</item>
        <item>com.canal.android.canal</item>
        <item>com.android.vending</item>
    </string-array>

    <!-- Show another app's banner on a tile, as "app>source". The source can stay installed or hidden. -->
    <string-array name="banner_from">
        <item>io.gh.reisxd.tizentube.cobalt>com.google.android.youtube.tv</item>
    </string-array>

    <!-- Never shown as tiles: system helpers, and the Live TV app (it's in the Inputs menu). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.xiaomi.mitv.manualhelp</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out.
         Common ones: com.tcl.tv (TCL), com.mediatek.wwtv.tvcenter (Xiaomi, many MediaTek sets),
         com.google.android.tv (Google Live Channels), com.sony.dtv.tvx (Sony). -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">6</integer>
</resources>
