<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mihir.tvhome"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Spotify widget only: Web API + cover art. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Own wallpapers in /sdcard/Pictures/TVHome; granted over ADB at install. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- App switcher: recently used apps (granted over ADB) and closing them. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.mediatek.wwtv.tvcenter" />
    </queries>

    <application
        android:label="Home"
        android:icon="@drawable/ic_home"
        android:banner="@drawable/ic_home"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Long-press Home: its own task so Back returns to the app you were in. -->
        <activity
            android:name=".SwitcherActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape"
            android:theme="@style/Switcher" />

        <service
            android:name=".KeyService"
            android:label="@string/key_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/key_service" />
        </service>
    </application>
</manifest>
